# Normal curriculum translation API key.
# Create this key in Google AI Studio. If omitted, GEMINI_API_KEY is used.
GEMINI_TRANSLATION_API_KEY=your_translation_gemini_api_key_here

# Dedicated PDF/OCR API key.
# Prefer a key from a separate Google AI Studio/GCP project if you want
# separate quota from normal translation traffic.
GEMINI_PDF_API_KEY=your_pdf_gemini_api_key_here

# Backward-compatible fallback if either dedicated key is omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# Normal translation model fallback order.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# PDF/OCR model fallback order.
GEMINI_PDF_MODELS=gemini-3.8-flash,gemini-3.7-flash

# Large PDF translation brain.
LAYOUT_WORKERS=4
LAYOUT_BATCH_CHARS=12000
LAYOUT_MODEL_RETRIES=2
LAYOUT_REQUEUE_LIMIT=2
LAYOUT_REQUEST_TIMEOUT=120
