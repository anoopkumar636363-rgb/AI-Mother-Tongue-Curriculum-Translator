# Your Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated fallback order.
# The app automatically tries the next model if a model is unavailable/rate-limited.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Large PDF translation brain (optional)
LAYOUT_WORKERS=4
LAYOUT_BATCH_CHARS=12000
LAYOUT_MODEL_RETRIES=2
LAYOUT_REQUEUE_LIMIT=2
LAYOUT_REQUEST_TIMEOUT=120
